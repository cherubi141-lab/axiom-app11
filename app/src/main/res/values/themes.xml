<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Axiom" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/void_bg</item>
        <item name="android:navigationBarColor">@color/void_bg</item>
        <item name="android:windowBackground">@color/void_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Shown for the brief instant before the WebView finishes its first
         paint, so the launch looks like a continuation of the app's own
         dark/purple backdrop instead of a flash of white. -->
    <style name="Theme.Axiom.Splash" parent="Theme.Axiom">
        <item name="android:windowBackground">@color/void_bg</item>
    </style>

</resources>
